#!/bin/sh
# MicroOS v1.0 System Information Utility (/usr/local/bin/sysinfo)

set -u

kernel="$(uname -srm)"
arch="$(uname -m)"
host="$(hostname 2>/dev/null || echo micro)"
up_sec="$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || echo 0)"
up_min=$((up_sec / 60))
up_rem=$((up_sec % 60))
cpu_model="$(awk -F: '/^model name/{gsub(/^[ \t]+/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null || echo Unknown)"
cpu_cnt="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"
mem_tot="$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
mem_avail="$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
mem_used=$((mem_tot - mem_avail))
fw="BIOS/Legacy"
[ -d /sys/firmware/efi ] && fw="UEFI"
mode="Minimal Live Mode (RAM)"
grep -q " /persist " /proc/mounts 2>/dev/null && mode="Persistent Storage (/persist)"
apt_state="Unavailable (requires persistent storage)"
for c in /persist/debian /mnt/ssd/debian /mnt/ssd/microos/debian; do
    [ -x "$c/usr/bin/apt-get" ] && apt_state="Ready ($c)" && break
done

echo "========================================"
echo "  MICROOS v1.0"
echo "  Minimal Linux. Maximum control."
echo "========================================"
echo "  Hostname   : $host"
echo "  Kernel     : $kernel"
echo "  Arch       : $arch"
echo "  Firmware   : $fw"
echo "  CPU        : $cpu_model ($cpu_cnt vCPU)"
echo "  Memory     : ${mem_used} MB used / ${mem_tot} MB total (${mem_avail} MB available)"
echo "  Uptime     : ${up_min}m ${up_rem}s"
echo "  Mode       : $mode"
echo "  APT/dpkg   : $apt_state"
echo "========================================"
