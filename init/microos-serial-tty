#!/bin/sh
# Only attach a login shell to /dev/ttyS0 if a real UART is present and working.
# On physical laptops without COM1, sleep quietly so init does not respawn-loop.
if [ -c /dev/ttyS0 ] && stty -F /dev/ttyS0 >/dev/null 2>&1; then
    exec /sbin/getty -n -l /usr/local/sbin/microos-shell 115200 ttyS0 vt100
fi
while true; do
    sleep 3600
done
